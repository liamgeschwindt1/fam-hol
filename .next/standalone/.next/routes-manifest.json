{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, nofollow"
        }
      ],
      "regex": "^(?:/(.*))(?:/)?$"
    }
  ],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/trips/[id]/comments",
      "regex": "^/api/trips/([^/]+?)/comments(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/trips/(?<nxtPid>[^/]+?)/comments(?:/)?$"
    },
    {
      "page": "/cal/[token]",
      "regex": "^/cal/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPtoken": "nxtPtoken"
      },
      "namedRegex": "^/cal/(?<nxtPtoken>[^/]+?)(?:/)?$"
    },
    {
      "page": "/join/[token]",
      "regex": "^/join/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPtoken": "nxtPtoken"
      },
      "namedRegex": "^/join/(?<nxtPtoken>[^/]+?)(?:/)?$"
    },
    {
      "page": "/trips/[id]",
      "regex": "^/trips/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/trips/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/trips/[id]/download-ics",
      "regex": "^/trips/([^/]+?)/download\\-ics(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/trips/(?<nxtPid>[^/]+?)/download\\-ics(?:/)?$"
    },
    {
      "page": "/trips/[id]/proposals/[pid]",
      "regex": "^/trips/([^/]+?)/proposals/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid",
        "nxtPpid": "nxtPpid"
      },
      "namedRegex": "^/trips/(?<nxtPid>[^/]+?)/proposals/(?<nxtPpid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/trips/[id]/suggest",
      "regex": "^/trips/([^/]+?)/suggest(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/trips/(?<nxtPid>[^/]+?)/suggest(?:/)?$"
    }
  ],
  "staticRoutes": [
    {
      "page": "/",
      "regex": "^/(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/(?:/)?$"
    },
    {
      "page": "/_not-found",
      "regex": "^/_not\\-found(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/_not\\-found(?:/)?$"
    },
    {
      "page": "/admin",
      "regex": "^/admin(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/admin(?:/)?$"
    },
    {
      "page": "/calendar",
      "regex": "^/calendar(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/calendar(?:/)?$"
    },
    {
      "page": "/inbox",
      "regex": "^/inbox(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/inbox(?:/)?$"
    },
    {
      "page": "/map",
      "regex": "^/map(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/map(?:/)?$"
    },
    {
      "page": "/me",
      "regex": "^/me(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/me(?:/)?$"
    },
    {
      "page": "/setup",
      "regex": "^/setup(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/setup(?:/)?$"
    },
    {
      "page": "/trips",
      "regex": "^/trips(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/trips(?:/)?$"
    },
    {
      "page": "/trips/new",
      "regex": "^/trips/new(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/trips/new(?:/)?$"
    },
    {
      "page": "/welcome-back",
      "regex": "^/welcome\\-back(?:/)?$",
      "routeKeys": {},
      "namedRegex": "^/welcome\\-back(?:/)?$"
    }
  ],
  "dataRoutes": [],
  "rsc": {
    "header": "rsc",
    "varyHeader": "rsc, next-router-state-tree, next-router-prefetch, next-router-segment-prefetch",
    "prefetchHeader": "next-router-prefetch",
    "didPostponeHeader": "x-nextjs-postponed",
    "contentTypeHeader": "text/x-component",
    "suffix": ".rsc",
    "prefetchSuffix": ".prefetch.rsc",
    "prefetchSegmentHeader": "next-router-segment-prefetch",
    "prefetchSegmentSuffix": ".segment.rsc",
    "prefetchSegmentDirSuffix": ".segments"
  },
  "rewriteHeaders": {
    "pathHeader": "x-nextjs-rewritten-path",
    "queryHeader": "x-nextjs-rewritten-query"
  }
}